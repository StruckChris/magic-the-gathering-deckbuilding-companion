<?xml version='1.0' encoding='utf-8'?>
<workbook original-version="10.5" source-platform="win" version="10.5">
  <preferences />
  <datasources>
    <datasource caption="Gameplay comparison" inline="true" name="gameplay" version="10.5">
      <connection class="textscan" directory="../../results" filename="gameplay_dashboard.csv" password="" server="">
        <relation name="gameplay_dashboard" table="[gameplay_dashboard#csv]" type="table">
          <columns header="yes" separator="," charset="UTF-8">
            <column datatype="string" name="view" ordinal="0" />
            <column datatype="string" name="deck" ordinal="1" />
            <column datatype="string" name="group" ordinal="2" />
            <column datatype="string" name="metric" ordinal="3" />
            <column datatype="string" name="display" ordinal="4" />
            <column datatype="string" name="value" ordinal="5" />
            <column datatype="string" name="detail" ordinal="6" />
          </columns>
        </relation>
      </connection>
      <column datatype="string" name="[view]" role="dimension" type="nominal" />
      <column datatype="string" name="[deck]" role="dimension" type="nominal" />
      <column datatype="string" name="[group]" role="dimension" type="nominal" />
      <column datatype="string" name="[metric]" role="dimension" type="nominal" />
      <column datatype="string" name="[display]" role="dimension" type="nominal" />
      <column datatype="string" name="[value]" role="dimension" type="nominal" />
      <column datatype="string" name="[detail]" role="dimension" type="nominal" />
    </datasource>
    <datasource caption="Deck capabilities" inline="true" name="strategy" version="10.5">
      <connection class="textscan" directory="../../results" filename="strategy_cells.csv" password="" server="">
        <relation name="strategy_cells" table="[strategy_cells#csv]" type="table">
          <columns header="yes" separator="," charset="UTF-8">
            <column datatype="string" name="view" ordinal="0" />
            <column datatype="string" name="deck" ordinal="1" />
            <column datatype="string" name="group" ordinal="2" />
            <column datatype="string" name="category" ordinal="3" />
            <column datatype="integer" name="position" ordinal="4" />
            <column datatype="integer" name="count" ordinal="5" />
            <column datatype="real" name="slot_share" ordinal="6" />
            <column datatype="string" name="symbol_equivalents" ordinal="7" />
            <column datatype="string" name="colored_symbol_total" ordinal="8" />
            <column datatype="string" name="cards" ordinal="9" />
            <column datatype="string" name="deck_order" ordinal="10" />
            <column datatype="string" name="group_order" ordinal="11" />
            <column datatype="string" name="field_label" ordinal="12" />
          </columns>
        </relation>
      </connection>
      <column datatype="string" name="[view]" role="dimension" type="nominal" />
      <column datatype="string" name="[deck]" role="dimension" type="nominal" />
      <column datatype="string" name="[group]" role="dimension" type="nominal" />
      <column datatype="string" name="[category]" role="dimension" type="nominal" />
      <column datatype="integer" name="[position]" role="measure" type="quantitative" />
      <column datatype="integer" name="[count]" role="measure" type="quantitative" />
      <column datatype="real" name="[slot_share]" role="measure" type="quantitative" />
      <column datatype="string" name="[symbol_equivalents]" role="dimension" type="nominal" />
      <column datatype="string" name="[colored_symbol_total]" role="dimension" type="nominal" />
      <column datatype="string" name="[cards]" role="dimension" type="nominal" />
      <column datatype="string" name="[deck_order]" role="dimension" type="nominal" />
      <column datatype="string" name="[group_order]" role="dimension" type="nominal" />
      <column datatype="string" name="[field_label]" role="dimension" type="nominal" />
    </datasource>
    <datasource caption="Player and public reference" inline="true" name="pairs" version="10.5">
      <connection class="textscan" directory="../../results" filename="strategy_pairs.csv" password="" server="">
        <relation name="strategy_pairs" table="[strategy_pairs#csv]" type="table">
          <columns header="yes" separator="," charset="UTF-8">
            <column name="view" datatype="string" ordinal="0" />
            <column name="reference" datatype="string" ordinal="1" />
            <column name="reference_choice" datatype="string" ordinal="2" />
            <column name="cohort" datatype="string" ordinal="3" />
            <column name="side" datatype="string" ordinal="4" />
            <column name="deck" datatype="string" ordinal="5" />
            <column name="category" datatype="string" ordinal="6" />
            <column name="position" datatype="integer" ordinal="7" />
            <column name="count" datatype="integer" ordinal="8" />
            <column name="cards" datatype="string" ordinal="9" />
          </columns>
        </relation>
      </connection>
      <column name="[view]" datatype="string" role="dimension" type="nominal" />
      <column name="[reference]" datatype="string" role="dimension" type="nominal" />
      <column name="[reference_choice]" datatype="string" role="dimension" type="nominal" />
      <column name="[cohort]" datatype="string" role="dimension" type="nominal" />
      <column name="[side]" datatype="string" role="dimension" type="nominal" />
      <column name="[deck]" datatype="string" role="dimension" type="nominal" />
      <column name="[category]" datatype="string" role="dimension" type="nominal" />
      <column name="[position]" datatype="integer" role="measure" type="quantitative" />
      <column name="[count]" datatype="integer" role="measure" type="quantitative" />
      <column name="[cards]" datatype="string" role="dimension" type="nominal" />
    </datasource>
    <datasource caption="Gameplay evidence" inline="true" name="review" version="10.5">
      <connection class="textscan" directory="../../results" filename="review_details.csv" password="" server="">
        <relation name="review_details" table="[review_details#csv]" type="table">
          <columns header="yes" separator="," charset="UTF-8">
            <column name="section" datatype="string" ordinal="0" />
            <column name="deck" datatype="string" ordinal="1" />
            <column name="deck_label" datatype="string" ordinal="2" />
            <column name="deck_order" datatype="integer" ordinal="3" />
            <column name="heading" datatype="string" ordinal="4" />
            <column name="detail" datatype="string" ordinal="5" />
            <column name="cost" datatype="string" ordinal="6" />
            <column name="timing" datatype="string" ordinal="7" />
            <column name="conditions" datatype="string" ordinal="8" />
            <column name="url" datatype="string" ordinal="9" />
          </columns>
        </relation>
      </connection>
      <column name="[section]" datatype="string" role="dimension" type="nominal" />
      <column name="[deck]" datatype="string" role="dimension" type="nominal" />
      <column name="[deck_label]" datatype="string" role="dimension" type="nominal" />
      <column name="[deck_order]" datatype="integer" role="dimension" type="nominal" />
      <column name="[heading]" datatype="string" role="dimension" type="nominal" />
      <column name="[detail]" datatype="string" role="dimension" type="nominal" />
      <column name="[cost]" datatype="string" role="dimension" type="nominal" />
      <column name="[timing]" datatype="string" role="dimension" type="nominal" />
      <column name="[conditions]" datatype="string" role="dimension" type="nominal" />
      <column name="[url]" datatype="string" role="dimension" type="nominal" />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Head-to-head marks">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true">Your deck vs. public reference | card count</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Player and public reference" name="pairs" />
          </datasources>
          <datasource-dependencies datasource="pairs">
            <column name="[view]" datatype="string" role="dimension" type="nominal" />
            <column name="[reference]" datatype="string" role="dimension" type="nominal" />
            <column name="[reference_choice]" datatype="string" role="dimension" type="nominal" />
            <column name="[cohort]" datatype="string" role="dimension" type="nominal" />
            <column name="[side]" datatype="string" role="dimension" type="nominal" />
            <column name="[deck]" datatype="string" role="dimension" type="nominal" />
            <column name="[category]" datatype="string" role="dimension" type="nominal" />
            <column name="[position]" datatype="integer" role="measure" type="quantitative" />
            <column name="[count]" datatype="integer" role="measure" type="quantitative" />
            <column name="[cards]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[view]" derivation="None" name="[none:view:nk]" pivot="key" type="nominal" />
            <column-instance column="[reference]" derivation="None" name="[none:reference:nk]" pivot="key" type="nominal" />
            <column-instance column="[reference_choice]" derivation="None" name="[none:reference_choice:nk]" pivot="key" type="nominal" />
            <column-instance column="[cohort]" derivation="None" name="[none:cohort:nk]" pivot="key" type="nominal" />
            <column-instance column="[side]" derivation="None" name="[none:side:nk]" pivot="key" type="nominal" />
            <column-instance column="[deck]" derivation="None" name="[none:deck:nk]" pivot="key" type="nominal" />
            <column-instance column="[category]" derivation="None" name="[none:category:nk]" pivot="key" type="nominal" />
            <column-instance column="[position]" derivation="Sum" name="[sum:position:qk]" pivot="key" type="quantitative" />
            <column-instance column="[count]" derivation="Sum" name="[sum:count:qk]" pivot="key" type="quantitative" />
            <column-instance column="[cards]" derivation="None" name="[none:cards:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[pairs].[none:reference_choice:nk]">
            <groupfilter function="member" level="[none:reference_choice:nk]" member="&quot;02 | Bracket 4 | Fire Lord Azula&quot;" />
          </filter>
          <filter class="categorical" column="[pairs].[none:view:nk]">
            <groupfilter function="member" level="[none:view:nk]" member="&quot;Deployment routes&quot;" />
          </filter>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[pairs].[none:side:nk]" />
              <text column="[pairs].[sum:count:qk]" />
              <tooltip column="[pairs].[none:cards:nk]" />
              <lod column="[pairs].[none:deck:nk]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run>[pairs].[none:deck:nk] | [pairs].[none:category:nk]
[pairs].[none:cards:nk]</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>([pairs].[none:category:nk] / [pairs].[none:side:nk])</rows>
        <cols>[pairs].[sum:count:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Compare | Deployment routes marks">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true">Deployment routes</run>
