            <column-instance column="[section]" name="[none:section:nk]" derivation="None" pivot="key" type="nominal" />
            <column-instance column="[deck]" name="[none:deck:nk]" derivation="None" pivot="key" type="nominal" />
            <column-instance column="[deck_label]" name="[none:deck_label:nk]" derivation="None" pivot="key" type="nominal" />
            <column-instance column="[deck_order]" name="[none:deck_order:nk]" derivation="None" pivot="key" type="nominal" />
            <column-instance column="[heading]" name="[none:heading:nk]" derivation="None" pivot="key" type="nominal" />
            <column-instance column="[detail]" name="[none:detail:nk]" derivation="None" pivot="key" type="nominal" />
            <column-instance column="[cost]" name="[none:cost:nk]" derivation="None" pivot="key" type="nominal" />
            <column-instance column="[timing]" name="[none:timing:nk]" derivation="None" pivot="key" type="nominal" />
            <column-instance column="[conditions]" name="[none:conditions:nk]" derivation="None" pivot="key" type="nominal" />
            <column-instance column="[url]" name="[none:url:nk]" derivation="None" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[review].[none:section:nk]">
            <groupfilter function="member" level="[none:section:nk]" member="&quot;Definitions&quot;" />
          </filter>
          <aggregation value="true" />
        </view>
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[review].[none:detail:nk]" />
              <tooltip column="[review].[none:cost:nk]" />
              <tooltip column="[review].[none:conditions:nk]" />
              <tooltip column="[review].[none:timing:nk]" />
              <tooltip column="[review].[none:url:nk]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run>[review].[none:heading:nk]
[review].[none:cost:nk]
[review].[none:timing:nk]
[review].[none:conditions:nk]
[review].[none:detail:nk]
[review].[none:url:nk]</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>[review].[none:heading:nk]</rows>
        <cols />
      </table>
    </worksheet>
  </worksheets>
