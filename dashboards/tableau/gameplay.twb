            <column datatype="string" name="[symbol_equivalents]" role="dimension" type="nominal" />
            <column datatype="string" name="[colored_symbol_total]" role="dimension" type="nominal" />
            <column datatype="string" name="[cards]" role="dimension" type="nominal" />
            <column datatype="string" name="[deck_order]" role="dimension" type="nominal" />
            <column datatype="string" name="[group_order]" role="dimension" type="nominal" />
            <column datatype="string" name="[field_label]" role="dimension" type="nominal" />
            <column-instance column="[view]" derivation="None" name="[none:view:nk]" pivot="key" type="nominal" />
            <column-instance column="[deck]" derivation="None" name="[none:deck:nk]" pivot="key" type="nominal" />
            <column-instance column="[group]" derivation="None" name="[none:group:nk]" pivot="key" type="nominal" />
            <column-instance column="[category]" derivation="None" name="[none:category:nk]" pivot="key" type="nominal" />
            <column-instance column="[position]" derivation="Sum" name="[sum:position:qk]" pivot="key" type="quantitative" />
            <column-instance column="[count]" derivation="Sum" name="[sum:count:qk]" pivot="key" type="quantitative" />
            <column-instance column="[slot_share]" derivation="Sum" name="[sum:slot_share:qk]" pivot="key" type="quantitative" />
            <column-instance column="[symbol_equivalents]" derivation="None" name="[none:symbol_equivalents:nk]" pivot="key" type="nominal" />
            <column-instance column="[colored_symbol_total]" derivation="None" name="[none:colored_symbol_total:nk]" pivot="key" type="nominal" />
            <column-instance column="[cards]" derivation="None" name="[none:cards:nk]" pivot="key" type="nominal" />
            <column-instance column="[deck_order]" derivation="None" name="[none:deck_order:nk]" pivot="key" type="nominal" />
            <column-instance column="[group_order]" derivation="None" name="[none:group_order:nk]" pivot="key" type="nominal" />
            <column-instance column="[field_label]" derivation="None" name="[none:field_label:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[strategy].[none:view:nk]">
            <groupfilter function="member" level="[none:view:nk]" member="&quot;Deployment routes&quot;" />
          </filter>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Square" />
            <encodings>
              <color column="[strategy].[sum:count:qk]" />
              <text column="[strategy].[sum:count:qk]" />
              <tooltip column="[strategy].[none:cards:nk]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold="true">[strategy].[none:deck:nk] / [strategy].[none:category:nk]
</run>
                <run>[strategy].[sum:count:qk]  |  [strategy].[none:cards:nk]</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>[strategy].[none:field_label:nk]</rows>
        <cols>[strategy].[none:category:nk]</cols>
      </table>
    </worksheet>
